{
  "name": "secure-agents-server",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-agent SaaS API — Express + Prisma (ClassPe-aligned), ported from the platform skeleton.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:gen-pg": "node scripts/gen-pg-schema.js",
    "migrate:status": "prisma migrate status --schema prisma/schema.postgres.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "setup-browser": "npx puppeteer browsers install chrome"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "pdf-parse": "^1.1.1",
    "qrcode": "1.5.4",
    "whatsapp-web.js": "1.34.8",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.2",
    "@types/ws": "8.18.2",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "2.1.8"
  }
}
