# Copy to ".env".
DATABASE_URL="file:./dev.db"
ANTHROPIC_API_KEY=
PORT=4000
# Comma-separated allowed web origins for CORS (the client dev server).
# In production this MUST be set — the server no longer reflects an arbitrary origin (FND-19).
CORS_ORIGIN=http://localhost:5173

# Signs website chat-widget keys (FND-12). Set a long random string in production;
# rotating it invalidates every previously-issued widget install snippet.
WIDGET_SIGNING_SECRET=

# Encrypts secrets at rest (channel tokens; connected accounts later) — AES-256-GCM (SEC-1).
# Use 32 bytes as hex (64 chars) or base64; any passphrase is accepted (derived via SHA-256).
# REQUIRED in production (the server refuses to boot without it — SEC-17).
ENCRYPTION_KEY=

# WhatsApp Cloud API — delivers signup + password-reset OTP codes.
# Without these set, dev echoes the code as `devOtp` in the API response so the
# flow is testable without a live phone. Get them from the Meta WhatsApp Cloud
# API (same provider/template as ClassPe). Defaults shown for the OTP template.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_TOKEN=
# WHATSAPP_OTP_TEMPLATE=classpe_otp_v1
# WHATSAPP_OTP_LANG=en_US
# WHATSAPP_API_VERSION=v24.0
# WHATSAPP_SEND_ENABLED=true

# Transcribe ASR service — powers the voice-to-text mic in the UI (POST /api/transcribe).
# The key stays server-side and is never exposed to the browser. Leave TRANSCRIBE_API_KEY
# unset to hide the mic (the /api/config `transcribe` flag goes false). model=auto lets the
# service pick the engine; omit a language in the UI to auto-detect.
TRANSCRIBE_API_URL=https://transcribe.codevel.com
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=auto
