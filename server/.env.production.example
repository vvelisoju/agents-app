# Copy to server/.env.production for Docker/compose.
# Dev default is SQLite; for Postgres set a postgres URL AND change the provider in
# prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./prod.db"
# DATABASE_URL="postgresql://postgres:agents@postgres:5432/agents"

ANTHROPIC_API_KEY=
PORT=4000

# The deployed client origin(s), comma-separated, for CORS.
CORS_ORIGIN=https://app.yourdomain.com

# Billing (optional until you wire Razorpay checkout + webhook).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Set automatically inside the Docker image; leave unset locally.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
