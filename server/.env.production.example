# ── Railway / Docker production env ──────────────────────────────────────────
# Copy to server/.env.production for local Docker Compose.
# On Railway, set these directly in the service Variables tab.
#
# DATABASE_URL is provided automatically by Railway when you link the Postgres
# service to agents-app. Do NOT set it manually on Railway.
#
# For local Docker Compose with Postgres:
#   DATABASE_URL="postgresql://postgres:agents@postgres:5432/agents"
# For local Docker Compose with SQLite (also change schema.prisma provider back):
#   DATABASE_URL="file:./prod.db"

DATABASE_URL="postgresql://postgres:agents@postgres:5432/agents"

# Your Anthropic (Claude) API key — console.anthropic.com
ANTHROPIC_API_KEY=

PORT=4000

# The deployed client origin, comma-separated, for CORS.
# On Railway this is your Vercel/Netlify URL or your custom domain.
CORS_ORIGIN=https://app.yourdomain.com

# WhatsApp Cloud API — REQUIRED in production: delivers signup + password-reset
# OTP codes. In production there is no devOtp fallback, so signup/reset cannot
# work without these. Same provider/template setup as ClassPe.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_OTP_TEMPLATE=classpe_otp_v1
WHATSAPP_OTP_LANG=en_US
WHATSAPP_API_VERSION=v24.0
WHATSAPP_SEND_ENABLED=true

# Billing (Razorpay checkout + verify are wired; add your own account's keys).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Set by the Docker image; leave unset here.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# NODE_ENV=production
