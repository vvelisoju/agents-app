# ---------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your key.
#   cp .env.example .env      (Git Bash)
#   copy .env.example .env    (Windows CMD)
# The .env file is git-ignored, so your key stays private.
# ---------------------------------------------------------------

# Your Anthropic (Claude) API key. Get one at: https://console.anthropic.com/
# It looks like: sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=your_anthropic_api_key_here
