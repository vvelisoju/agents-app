{
  "compilerOptions": {
    "target": "ES2021",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
